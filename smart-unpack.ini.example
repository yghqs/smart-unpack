# smart-unpack 配置文件（样例）
#
# 用法：把本文件复制成同目录下的 `smart-unpack.ini`，按需改。
#       没有这个文件也照常跑 —— 全用程序里的默认值。
# 优先级：**命令行参数  >  本文件  >  程序默认值**。
#
# 每一项的取值类型照默认值来：有小数点的写小数，true/false 的写 true 或 false。

[smart-unpack]

# **盘上占用**多少 GB 就全场停止 —— 量的是「现在盘上还占着多少」，不是「一共写出过多少」：
# 嵌套包的中间层一解开就当场收走、额度还回 ⇒ 套娃再深也不会按层数翻倍扣额度

上限GB      = 5

# 输出目录名按此后缀归一化
输出后缀    = .zip

# 只处理这些后缀（逗号分隔，如 mp3,jpg）；留空 = 全都处理
仅处理后缀  =

# 是否连子目录一起找
递归子目录  = true

# 解几层：0 = 自动（解出来还是压缩包就接着解）
解压层数    = 0

# 自动模式的安全上限（最多解这么多层）
上限层数    = 6

# 连续这么多秒**一个字节都写不出来**才判卡死、放弃该条目。
# 注意：判「卡死」只看有没有进展，不看总耗时 —— 慢但一直在写的不会被动。
停滞秒      = 120

# 单条目总耗时上限；0 = 不限（慢 ≠ 坏，一般别设）
条目超时秒  = 0

# 大条目（≥20MB）每这么多秒报一次「已写 X/Y」
心跳秒      = 10

# 单条目超过这么多秒，单独记一行
条目记账秒  = 2.0

# 整包合计超过这么多秒，才多打一行「哪一段最费时」
整包明细秒  = 10.0

# 放法：false = 每个源包一个目录；true = 全部合并到一个文件夹
集中模式    = false

# 「只解压缩包」模式的兜底名单（逗号分隔）。这些后缀**只当交付物、不拆**。
# 主判据是**内容特征**（包里带 [Content_Types].xml / META-INF/MANIFEST.MF / project.json …）；
# 这份名单只在内容判不出来时补一刀。**新格式出来自己往后加一条就行。**
# 要整个无视它（见到 zip 就拆）：命令行加 --全部拆
不拆后缀    = .docx,.docm,.dotx,.xlsx,.xlsm,.xltx,.pptx,.pptm,.odt,.ods,.odp,.odg,.epub,.jar,.apk,.whl,.egg,.sb3,.vsix,.nupkg,.kra,.ora
